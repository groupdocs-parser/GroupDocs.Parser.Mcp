<Project>

  <PropertyGroup Label="SDK Versions">
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible build">
    <Deterministic>true</Deterministic>
    <!-- Normalizes paths inside .pdb/.dll on CI for reproducible output -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package information">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/groupdocs-parser/GroupDocs.Parser.Mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/groupdocs-parser/GroupDocs.Parser.Mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>GroupDocs Contributors</Authors>
    <Company>Aspose</Company>
    <Copyright>Copyright © Aspose Pty Ltd $([System.DateTime]::Now.Year)</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>true</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <GroupDocsParserMcp>26.7.0</GroupDocsParserMcp>
  </PropertyGroup>

  <PropertyGroup Label="External Dependency Versions">
    <GroupDocsMcpCore>26.4.1</GroupDocsMcpCore>
    <!-- 26.6.1 is TFM-split (net462 / netstandard2.1). Under net10.0 NuGet resolves the
         GroupDocs.Parser.NetStandard21 runtime sub-package, which declares SkiaSharp +
         SkiaSharp.NativeAssets.Linux.NoDependencies (3.119.1), Aspose.Drawing, and
         Microsoft.ML.OnnxRuntime transitively — so native libSkiaSharp ships without our
         help and the old manual NativeAssets.Linux ref was removed. See assets/backlog-and-issues.md. -->
    <GroupDocsParser>26.6.1</GroupDocsParser>
    <MicrosoftExtensionsHosting>10.0.5</MicrosoftExtensionsHosting>
    <ModelContextProtocol>1.1.0</ModelContextProtocol>
    <MicrosoftSourceLinkGithub>8.0.0</MicrosoftSourceLinkGithub>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Common Settings">
    <PackageReleaseNotes>https://github.com/groupdocs-parser/GroupDocs.Parser.Mcp/releases/tag/$(GroupDocsParserMcp)</PackageReleaseNotes>
  </PropertyGroup>

</Project>
